# 복사해서 .env 로 저장하고 값을 채우세요. .env 는 절대 커밋하지 마세요.

# Claude API 키 (https://console.anthropic.com/ 에서 발급)
# 비어 있으면 앱이 Mock 모드로 동작합니다.
ANTHROPIC_API_KEY=

# 사용할 모델
ANTHROPIC_MODEL=claude-sonnet-5-5

# Google 서비스 계정 JSON 파일 경로 (예: credentials/service_account.json)
# 비어 있으면 data/*.csv 의 가상 데이터를 사용합니다.
GOOGLE_SERVICE_ACCOUNT_FILE=

# 구글 스프레드시트 ID (URL 의 /d/ 와 /edit 사이 문자열)
GOOGLE_SHEET_ID=
